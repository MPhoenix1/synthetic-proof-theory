{-# OPTIONS --safe --without-K #-}

module SPT.Mahlo.Residence.Adjoined where

-- A Tarski universe generated by the formers over a small family (L, D)
-- and a family (I, E) whose indices may lie one level higher. Form retains
-- the formation of each type; Name pairs that type with its formation.
-- The lifted, below and adjoined constructors name D l, L and E i.
-- The formers decode by computation (name-formers, name-decoding).

open import SPT.Base
import SPT.Mahlo.Specification as Reflection
open import SPT.Foundation.Tree.W using (W)
open import SPT.Mahlo.Decoding using (DecodingLaws)

------------------------------------------------------------------------
-- Generated names and their decoding

module _ {ℓ : Level} (L : Set ℓ) (D : L → Set ℓ) (I : Set (lsuc ℓ))
  (E : I → Set ℓ) where

  data Form : Set ℓ → Set (lsuc ℓ) where
    emptyᶠ : Form (Lift ℓ 𝟘)
    unitᶠ : Form (Lift ℓ 𝟙)
    twoᶠ : Form (Lift ℓ 𝟚)
    naturalᶠ : Form (Lift ℓ ℕ)
    productᶠ : {A : Set ℓ} {B : A → Set ℓ} →
      Form A → ((x : A) → Form (B x)) → Form ((x : A) → B x)
    sumᶠ : {A : Set ℓ} {B : A → Set ℓ} →
      Form A → ((x : A) → Form (B x)) → Form (Σ A B)
    treeᶠ : {A : Set ℓ} {B : A → Set ℓ} →
      Form A → ((x : A) → Form (B x)) → Form (W A B)
    identityᶠ : {A : Set ℓ} → Form A → (x y : A) → Form (x ＝ y)
    liftedᶠ : (l : L) → Form (D l)
    belowᶠ : Form L
    adjoinedᶠ : (i : I) → Form (E i)

  Name : Set (lsuc ℓ)
  Name = Σ (Set ℓ) Form

  decode : Name → Set ℓ
  decode a = pr₁ a

------------------------------------------------------------------------
-- The formers and their laws

module _ {ℓ : Level} {L : Set ℓ} {D : L → Set ℓ} {I : Set (lsuc ℓ)}
  {E : I → Set ℓ} where

  empty unit two natural : Name L D I E
  empty = Lift ℓ 𝟘 , emptyᶠ
  unit = Lift ℓ 𝟙 , unitᶠ
  two = Lift ℓ 𝟚 , twoᶠ
  natural = Lift ℓ ℕ , naturalᶠ

  product sum tree :
    (a : Name L D I E) → (decode L D I E a → Name L D I E) → Name L D I E
  product a b =
    ((x : decode L D I E a) → decode L D I E (b x))
    , productᶠ (pr₂ a) (λ x → pr₂ (b x))
  sum a b =
    Σ (decode L D I E a) (λ x → decode L D I E (b x))
    , sumᶠ (pr₂ a) (λ x → pr₂ (b x))
  tree a b =
    W (decode L D I E a) (λ x → decode L D I E (b x))
    , treeᶠ (pr₂ a) (λ x → pr₂ (b x))

  identity :
    (a : Name L D I E) → decode L D I E a → decode L D I E a → Name L D I E
  identity a x y = (x ＝ y) , identityᶠ (pr₂ a) x y

  lifted : L → Name L D I E
  lifted l = D l , liftedᶠ l

  below : Name L D I E
  below = L , belowᶠ

  adjoined : I → Name L D I E
  adjoined i = E i , adjoinedᶠ i

module _ {ℓ : Level} (L : Set ℓ) (D : L → Set ℓ) (I : Set (lsuc ℓ))
  (E : I → Set ℓ) where

  name-formers : Reflection.Formers (Name L D I E) (decode L D I E)
  name-formers = record
    { empty = empty
    ; unit = unit
    ; two = two
    ; natural = natural
    ; product = λ F → product (pr₁ F) (pr₂ F)
    ; sum = λ F → sum (pr₁ F) (pr₂ F)
    ; tree = λ F → tree (pr₁ F) (pr₂ F)
    ; identity = identity
    }

  name-decoding : DecodingLaws name-formers
  name-decoding = record
    { empty-β = refl
    ; unit-β = refl
    ; two-β = refl
    ; natural-β = refl
    ; product-β = λ a b → refl
    ; sum-β = λ a b → refl
    ; tree-β = λ a b → refl
    ; identity-β = λ a x y → refl
    }

------------------------------------------------------------------------
-- The empty family of adjoined types

absent : {α β : Level} → Lift α 𝟘 → Set β
absent (lift ())
