{-# OPTIONS --safe --without-K #-}

module SPT.Mahlo.Residence.Containment where

-- An absorbed reflection lies inside every reflection of the same
-- operator (inside): each code has a name in the other reflection.
-- Only extensionality for maps from decoded domains into the parent
-- codes is required. Generation obstructs absorption (unabsorbed),
-- while the ambient universe is not generated by any operator
-- (ungenerated). Existing small least closures supply its absorption.

open import SPT.Base
open import SPT.Mahlo.Specification using
  (Family; Operator; map; Formers; Closure; Reflection; Name)
open import SPT.Mahlo.Decoding using (DecodingLaws)
open import SPT.Mahlo.Generation using
  (Tree-Law; Generated; unreflected; Branch-Extensionality; formed;
   branch-named; family-path)
open import SPT.Mahlo.Residence.Names using (identity-name)
open import SPT.Mahlo.Residence.Absorption using
  (Methods; Induction; Absorbed; Absorption)
open import SPT.Mahlo.Residence.Inductive using (ambient-absorbs)
import SPT.Mahlo.Ambient as Ambient

------------------------------------------------------------------------
-- Generation obstructs absorption

module _ {κ ℓ : Level} {C : Set κ} {D : C → Set ℓ} where

  unabsorbed : (Q : Formers C D) → Tree-Law Q → (Ψ : Operator D)
    (ν : Level) → Generated Q Ψ → ¬ Absorbed Q Ψ ν
  unabsorbed Q tree-β Ψ ν generated child =
    unreflected Q tree-β Ψ generated (Absorbed.reflection child)

ungenerated : (ℓ : Level) (Ψ : Operator (λ (X : Set ℓ) → X)) →
  ¬ Generated (Ambient.formers ℓ) Ψ
ungenerated ℓ Ψ generated = unreflected (Ambient.formers ℓ)
  (DecodingLaws.tree-β (Ambient.laws ℓ)) Ψ generated
  (Absorbed.reflection (Absorption.absorb (ambient-absorbs ℓ lzero) Ψ))

------------------------------------------------------------------------
-- Names in another reflection

module _ {ℓ κ : Level} {C : Set κ} {D : C → Set ℓ} {Q : Formers C D}
  {Ψ : Operator D}
  (child : Absorbed Q Ψ (κ ⊔ ℓ)) (ρ : Reflection Q Ψ)
  (let L = Reflection.closure (Absorbed.reflection child))
  (let L′ = Reflection.closure ρ) where

  Inside : D (Reflection.carrier (Absorbed.reflection child)) → Set (ℓ ⊔ κ)
  Inside x = Name (Closure.interpret L′) (Closure.interpret L x)

  -- The family of ρ naming the interpretation of φ.
  named-family : (φ : Family (λ x → D (Closure.interpret L x))) →
    Inside (pr₁ φ) →
    ((x : D (Closure.interpret L (pr₁ φ))) → Inside (pr₂ φ x)) →
    Family (λ x → D (Closure.interpret L′ x))
  named-family φ (x′ , p) branches =
    x′ , (λ y → pr₁ (branches (transport D p y)))

  module _ (ext : Branch-Extensionality D) where

    named-path : (φ : Family (λ x → D (Closure.interpret L x)))
      (n : Inside (pr₁ φ))
      (branches : (x : D (Closure.interpret L (pr₁ φ))) → Inside (pr₂ φ x)) →
      map D (Closure.interpret L′) (named-family φ n branches)
        ＝ map D (Closure.interpret L) φ
    named-path φ (x′ , p) branches = family-path ext p
      (λ x → Closure.interpret L (pr₂ φ x))
      (λ y → Closure.interpret L′ (pr₁ (branches (transport D p y))))
      (λ y → pr₂ (branches (transport D p y)))

    -- The operator's values at the two families.
    values : (φ : Family (λ x → D (Closure.interpret L x)))
      (n : Inside (pr₁ φ))
      (branches : (x : D (Closure.interpret L (pr₁ φ))) → Inside (pr₂ φ x)) →
      map D (Closure.interpret L′)
          (Closure.inner L′ (named-family φ n branches))
        ＝ map D (Closure.interpret L) (Closure.inner L φ)
    values φ n branches =
      Closure.inner-β L′ (named-family φ n branches)
      ∙ ap Ψ (named-path φ n branches)
      ∙ Closure.inner-β L φ ⁻¹

    steps : Methods L Inside
    steps = record
      { on-empty = transport (Name (Closure.interpret L′))
          (pr₂ (Closure.empty L) ⁻¹) (Closure.empty L′)
      ; on-unit = transport (Name (Closure.interpret L′))
          (pr₂ (Closure.unit L) ⁻¹) (Closure.unit L′)
      ; on-two = transport (Name (Closure.interpret L′))
          (pr₂ (Closure.two L) ⁻¹) (Closure.two L′)
      ; on-natural = transport (Name (Closure.interpret L′))
          (pr₂ (Closure.natural L) ⁻¹) (Closure.natural L′)
      ; on-product = λ φ n branches →
          transport (Name (Closure.interpret L′))
            (pr₂ (Closure.product L φ) ⁻¹)
            (formed ext L′ (Formers.product Q) (Closure.product L′)
              (Closure.interpret L (pr₁ φ))
              (λ x → Closure.interpret L (pr₂ φ x)) n branches)
      ; on-sum = λ φ n branches →
          transport (Name (Closure.interpret L′))
            (pr₂ (Closure.sum L φ) ⁻¹)
            (formed ext L′ (Formers.sum Q) (Closure.sum L′)
              (Closure.interpret L (pr₁ φ))
              (λ x → Closure.interpret L (pr₂ φ x)) n branches)
      ; on-tree = λ φ n branches →
          transport (Name (Closure.interpret L′))
            (pr₂ (Closure.tree L φ) ⁻¹)
            (formed ext L′ (Formers.tree Q) (Closure.tree L′)
              (Closure.interpret L (pr₁ φ))
              (λ x → Closure.interpret L (pr₂ φ x)) n branches)
      ; on-identity = λ x y₁ y₂ n →
          transport (Name (Closure.interpret L′))
            (pr₂ (Closure.identity L x y₁ y₂) ⁻¹)
            (identity-name Q Ψ L′ n y₁ y₂)
      ; on-result = λ φ n branches →
          pr₁ (Closure.inner L′ (named-family φ n branches))
          , ap pr₁ (values φ n branches)
      ; on-branch = λ φ t n branches →
          branch-named L′ (Closure.inner L′ (named-family φ n branches))
            (Closure.interpret L (pr₁ (Closure.inner L φ)))
            (λ z → Closure.interpret L (pr₂ (Closure.inner L φ) z))
            (values φ n branches) t
      }

    inside : (x : D (Reflection.carrier (Absorbed.reflection child))) →
      Inside x
    inside = Induction.induction (Absorbed.induction child) Inside steps
