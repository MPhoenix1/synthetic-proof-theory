{-# OPTIONS --safe --without-K #-}

module SPT.Mahlo.Generation where

-- A Tarski family generated by its formers and an operator has no
-- reflection when its trees decode exactly. Tree-Law alone rules out
-- a retraction onto the codes (no-retract); a reflection cannot name
-- its carrier (unnamed), hence a generated family is unreflected.
-- Families whose head and branches are named have named former values
-- (formed), using only extensionality on the decoded domains.

open import SPT.Base
open import SPT.Foundation.Extensionality using (FunExt)
open import SPT.Mahlo.Specification using
  (Family; Operator; map; Formers; Closure; Reflection; Name)
open import SPT.Foundation.Tree.W using (W; sup)
open import SPT.Mahlo.Decoding using (child-formers)
open import SPT.Mahlo.Paradox using (not-own-member)
open import SPT.Mahlo.Residence.Names using (family-join; former-name)

------------------------------------------------------------------------
-- The tree decoding equation suffices for the paradox

module _ {κ ℓ : Level} {C : Set κ} {D : C → Set ℓ} where

  Tree-Law : Formers C D → Set (κ ⊔ lsuc ℓ)
  Tree-Law Q = (a : C) (b : D a → C) →
    D (Formers.tree Q (a , b)) ＝ W (D a) (λ x → D (b x))

  no-retract : (Q : Formers C D) → Tree-Law Q → (c : C) (r : D c → C)
    (s : C → D c) → ((a : C) → r (s a) ＝ a) → 𝟘
  no-retract Q tree-β c r s section =
    let τ = Formers.tree Q (c , r)
        e = ap D (section τ) ∙ tree-β c r
        ω = sup (s τ) (transport id e)
    in not-own-member ω
         (transport id (e ⁻¹) ω , back-and-forth-transport id e ω)

------------------------------------------------------------------------
-- Reflected universes do not name their carriers

module _ {κ ℓ : Level} {C : Set κ} {D : C → Set ℓ} {Q : Formers C D}
  {Ψ : Operator D} where

  inherited : Tree-Law Q → {A : Set ℓ} (L : Closure Q Ψ A) →
    Tree-Law (child-formers L)
  inherited tree-β L a b = ap D (pr₂ (Closure.tree L (a , b)))
    ∙ tree-β (Closure.interpret L a) (λ x → Closure.interpret L (b x))

  unnamed : Tree-Law Q → (ρ : Reflection Q Ψ) →
    ¬ Name (Closure.interpret (Reflection.closure ρ)) (Reflection.carrier ρ)
  unnamed tree-β ρ (x , p) = no-retract
    (child-formers (Reflection.closure ρ))
    (inherited tree-β (Reflection.closure ρ)) x (transport D p)
    (transport D (p ⁻¹)) (back-and-forth-transport D p)

------------------------------------------------------------------------
-- Generation by an operator

module _ {κ ℓ : Level} {C : Set κ} {D : C → Set ℓ} where

  Generated : Formers C D → Operator D → Set (κ ⊔ lsuc ℓ)
  Generated Q Ψ = {A : Set ℓ} (L : Closure Q Ψ A) (a : C) →
    Name (Closure.interpret L) a

  unreflected : (Q : Formers C D) → Tree-Law Q → (Ψ : Operator D) →
    Generated Q Ψ → ¬ Reflection Q Ψ
  unreflected Q tree-β Ψ generated ρ = unnamed tree-β ρ
    (generated (Reflection.closure ρ) (Reflection.carrier ρ))

------------------------------------------------------------------------
-- Names of formed codes

module _ {κ ℓ : Level} {C : Set κ} where

  Branch-Extensionality : (C → Set ℓ) → Set (κ ⊔ ℓ)
  Branch-Extensionality D = (a : C) → FunExt (D a) (λ _ → C)

module _ {κ ℓ : Level} {C : Set κ} {D : C → Set ℓ} where

  family-path : Branch-Extensionality D → {a′ a : C} (p : a′ ＝ a)
    (b : D a → C) (g : D a′ → C) →
    ((y : D a′) → g y ＝ b (transport D p y)) →
    _＝_ {A = Family D} (a′ , g) (a , b)
  family-path ext {a′} refl b g h = ap (λ v → a′ , v) (ext a′ g b h)

module _ {κ ℓ : Level} {C : Set κ} {D : C → Set ℓ} {Q : Formers C D}
  {Ψ : Operator D} {A : Set ℓ} where

  formed : Branch-Extensionality D → (L : Closure Q Ψ A)
    (f : Family D → C)
    (close : (φ : Family (λ x → D (Closure.interpret L x))) →
      Name (Closure.interpret L) (f (map D (Closure.interpret L) φ)))
    (a : C) (b : D a → C) → Name (Closure.interpret L) a →
    ((y : D a) → Name (Closure.interpret L) (b y)) →
    Name (Closure.interpret L) (f (a , b))
  formed ext L f close a b (x , p) branches =
    former-name Q Ψ L f close
      ( (x , (λ y → pr₁ (branches (transport D p y))))
      , family-join D (Closure.interpret L) x p b branches (ext a))

  branch-named : (L : Closure Q Ψ A)
    (φ : Family (λ x → D (Closure.interpret L x))) (a : C) (f : D a → C) →
    map D (Closure.interpret L) φ ＝ (a , f) → (t : D a) →
    Name (Closure.interpret L) (f t)
  branch-named L φ _ _ refl t = pr₂ φ t , refl

------------------------------------------------------------------------
-- The selected identity code along an identification of its base

module _ {κ ℓ : Level} {C : Set κ} {D : C → Set ℓ} where

  identity-along : (Q : Formers C D) {a′ a : C} (p : a′ ＝ a)
    (x y : D a) →
    Formers.identity Q a′ (transport D (p ⁻¹) x) (transport D (p ⁻¹) y)
      ＝ Formers.identity Q a x y
  identity-along Q refl x y = refl
