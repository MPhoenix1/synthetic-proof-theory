{-# OPTIONS --safe --cubical-compatible #-}
{-# OPTIONS -WnoUnsupportedIndexedMatch #-}

module SPT.Cubical.Base.Natural where

-- The natural numbers `ℕ` are those of `Agda.Builtin.Nat`, with its addition
-- `+`, multiplication `*` and truncated subtraction `∸`. Agda evaluates these
-- by its primitives and reads numerals such as `3` as points of `ℕ`. SPT binds
-- no builtin of its own: Agda's `Agda.Builtin.Nat` already binds them, and a
-- second binding in one import closure is an error. The fixities are SPT's,
-- given in the renaming. Addition recurses on its left argument, so its laws at
-- zero and at successors on the right are proved here. The maximum `m ⊔ℕ n` is
-- written with a suffix, since `⊔` itself is the maximum of universe levels.
--
-- The structural order `m ≤ℕˢ n` is generated by `zero ≤ℕˢ n` and its successor
-- rule, and `m <ℕˢ n` is `suc m ≤ℕˢ n`. It is the order to induct along; the
-- computational order `<ℕᶜ`, read off a comparison function, is in
-- `SPT.Foundation.Nat.Order`. Distinct numbers are told apart: `zero` is not a
-- successor, the successor is injective, and equality is decidable.
--
-- Numbers are eliminated by `natural-elim`, computing at `zero` and `suc`,
-- and addition is associative (`+-assoc`). The maximum is an upper bound of
-- its arguments in the structural order (`≤ℕˢ-⊔ˡ`, `≤ℕˢ-⊔ʳ`), idempotent
-- (`⊔ℕ-idempotent`), and the larger of two comparable numbers
-- (`≤ℕˢ-gives-⊔ℕ-right`, `≤ℕˢ-gives-⊔ℕ-left`). Every number is below its
-- successor (`≤ℕˢ-to-suc`), no number is below zero (`nothing-below-zero`),
-- and only zero is below one (`below-one-is-zero`).
--
-- The stepwise order `m ≤ℕ′ n`, generated by `≤ℕ′-refl` and `≤ℕ′-step`,
-- recurses on the target, so iterations along it add one step at a time;
-- every structural inequality gives one (`≤ℕˢ-to-≤ℕ′`). A sequence rising at
-- every step rises along both orders (`increasing-along-≤ℕ′`,
-- `increasing-from-steps`):
--
--   g n <ℕˢ g (suc n) for every n gives g m <ℕˢ g n for every m <ℕˢ n.
--
-- An injective pairing of `ℕ × ℕ` into ℕ, with unpairing as a left inverse
-- (`ℕ-unpair-pair`). Unpairing walks the diagonals: from `(m , suc n)` the next
-- pair is `(suc m , n)`, and from `(m , 0)` it is `(0 , suc m)`, which starts
-- the next diagonal (`next-pair`). Pairing counts back: the pair `(m , n)` lies
-- `m` steps after the start of the diagonal `m + n`, and the diagonal `d`
-- starts after the `d` pairs of the one before (`diagonal-start`).
--
--   diagonal-start 0 = 0,
--   diagonal-start (d + 1) = diagonal-start d + d + 1,
--   ℕ-pair (m , n) = diagonal-start (m + n) + m.
--
-- So unpairing the successor of a pair is one step of the walk, and the inverse
-- law follows by induction along the diagonal and then down the diagonals.

open import Agda.Builtin.Nat public
  using (zero; suc)
  renaming
    ( Nat to ℕ
    ; _+_ to infixl 35 _+_
    ; _*_ to infixl 40 _*_
    ; _-_ to infixl 36 _∸_ )
open import SPT.Cubical.Base.Universes using (Level)
open import SPT.Cubical.Base.Empty using (¬_)
open import SPT.Cubical.Base.Identity using (_＝_; refl; _≠_; ap; _⁻¹; _∙_)
open import SPT.Cubical.Base.Sigma using (_,_; _×_)
open import SPT.Cubical.Base.Sum using (inl; inr; cases)
open import SPT.Cubical.Base.Trichotomy using (Trichotomy)
open import SPT.Cubical.Base.Decidable using (has-decidable-equality)

------------------------------------------------------------------------
-- The maximum

infixl 35 _⊔ℕ_

_⊔ℕ_ : ℕ → ℕ → ℕ
zero ⊔ℕ n = n
suc m ⊔ℕ zero = suc m
suc m ⊔ℕ suc n = suc (m ⊔ℕ n)

------------------------------------------------------------------------
-- The structural order

infix 30 _≤ℕˢ_ _<ℕˢ_

data _≤ℕˢ_ : ℕ → ℕ → Set where
  z≤n : {n : ℕ} → zero ≤ℕˢ n
  s≤s : {m n : ℕ} → m ≤ℕˢ n → suc m ≤ℕˢ suc n

_<ℕˢ_ : ℕ → ℕ → Set
m <ℕˢ n = suc m ≤ℕˢ n

------------------------------------------------------------------------
-- Addition at zero and at successors on the right

+-zero-right : (n : ℕ) → n + zero ＝ n
+-zero-right zero = refl
+-zero-right (suc n) = ap suc (+-zero-right n)

+-suc-right : (m n : ℕ) → m + suc n ＝ suc (m + n)
+-suc-right zero n = refl
+-suc-right (suc m) n = ap suc (+-suc-right m n)

------------------------------------------------------------------------
-- The structural order is reflexive and transitive

≤ℕˢ-refl : (n : ℕ) → n ≤ℕˢ n
≤ℕˢ-refl zero = z≤n
≤ℕˢ-refl (suc n) = s≤s (≤ℕˢ-refl n)

≤ℕˢ-trans : {l m n : ℕ} → l ≤ℕˢ m → m ≤ℕˢ n → l ≤ℕˢ n
≤ℕˢ-trans z≤n q = z≤n
≤ℕˢ-trans (s≤s p) (s≤s q) = s≤s (≤ℕˢ-trans p q)

≤ℕˢ-suc : {m n : ℕ} → m ≤ℕˢ n → m ≤ℕˢ suc n
≤ℕˢ-suc z≤n = z≤n
≤ℕˢ-suc (s≤s p) = s≤s (≤ℕˢ-suc p)

------------------------------------------------------------------------
-- The strict structural order is transitive and trichotomous

<ℕˢ-trans : {l m n : ℕ} → l <ℕˢ m → m <ℕˢ n → l <ℕˢ n
<ℕˢ-trans {l} {m} {n} p q = ≤ℕˢ-trans p (≤ℕˢ-trans (≤ℕˢ-suc (≤ℕˢ-refl m)) q)

<ℕˢ-irrefl : (n : ℕ) → ¬ (n <ℕˢ n)
<ℕˢ-irrefl zero ()
<ℕˢ-irrefl (suc n) (s≤s p) = <ℕˢ-irrefl n p

suc-preserves-trichotomy : (m n : ℕ) →
  Trichotomy _＝_ _<ℕˢ_ m n → Trichotomy _＝_ _<ℕˢ_ (suc m) (suc n)
suc-preserves-trichotomy m n (inl p) = inl (s≤s p)
suc-preserves-trichotomy m n (inr (inl e)) = inr (inl (ap suc e))
suc-preserves-trichotomy m n (inr (inr p)) = inr (inr (s≤s p))

<ℕˢ-trichotomy : (m n : ℕ) → Trichotomy _＝_ _<ℕˢ_ m n
<ℕˢ-trichotomy zero zero = inr (inl refl)
<ℕˢ-trichotomy zero (suc n) = inl (s≤s z≤n)
<ℕˢ-trichotomy (suc m) zero = inr (inr (s≤s z≤n))
<ℕˢ-trichotomy (suc m) (suc n) =
  suc-preserves-trichotomy m n (<ℕˢ-trichotomy m n)

------------------------------------------------------------------------
-- Zero and successors

zero-is-not-suc : {n : ℕ} → zero ≠ suc n
zero-is-not-suc ()

suc-is-injective : {m n : ℕ} → suc m ＝ suc n → m ＝ n
suc-is-injective refl = refl

------------------------------------------------------------------------
-- Equality is decidable

ℕ-has-decidable-equality : has-decidable-equality ℕ
ℕ-has-decidable-equality zero zero = inl refl
ℕ-has-decidable-equality zero (suc n) = inr zero-is-not-suc
ℕ-has-decidable-equality (suc m) zero =
  inr (λ e → zero-is-not-suc (e ⁻¹))
ℕ-has-decidable-equality (suc m) (suc n) =
  cases
    (λ e → inl (ap suc e))
    (λ d → inr (λ e → d (suc-is-injective e)))
    (ℕ-has-decidable-equality m n)

------------------------------------------------------------------------
-- Elimination of natural numbers

module _ {κ : Level} where

  natural-elim : (P : ℕ → Set κ) → P zero →
    ((n : ℕ) → P n → P (suc n)) → (n : ℕ) → P n
  natural-elim P z s zero = z
  natural-elim P z s (suc n) = s n (natural-elim P z s n)

------------------------------------------------------------------------
-- Associativity of addition

+-assoc : (m n k : ℕ) → (m + n) + k ＝ m + (n + k)
+-assoc zero n k = refl
+-assoc (suc m) n k = ap suc (+-assoc m n k)

------------------------------------------------------------------------
-- The maximum as an upper bound

≤ℕˢ-⊔ˡ : (m n : ℕ) → m ≤ℕˢ (m ⊔ℕ n)
≤ℕˢ-⊔ˡ zero n = z≤n
≤ℕˢ-⊔ˡ (suc m) zero = ≤ℕˢ-refl (suc m)
≤ℕˢ-⊔ˡ (suc m) (suc n) = s≤s (≤ℕˢ-⊔ˡ m n)

≤ℕˢ-⊔ʳ : (m n : ℕ) → n ≤ℕˢ (m ⊔ℕ n)
≤ℕˢ-⊔ʳ zero n = ≤ℕˢ-refl n
≤ℕˢ-⊔ʳ (suc m) zero = z≤n
≤ℕˢ-⊔ʳ (suc m) (suc n) = s≤s (≤ℕˢ-⊔ʳ m n)

------------------------------------------------------------------------
-- The maximum at comparable arguments

⊔ℕ-idempotent : (n : ℕ) → n ⊔ℕ n ＝ n
⊔ℕ-idempotent zero = refl
⊔ℕ-idempotent (suc n) = ap suc (⊔ℕ-idempotent n)

≤ℕˢ-gives-⊔ℕ-right : {m n : ℕ} → m ≤ℕˢ n → m ⊔ℕ n ＝ n
≤ℕˢ-gives-⊔ℕ-right z≤n = refl
≤ℕˢ-gives-⊔ℕ-right (s≤s p) = ap suc (≤ℕˢ-gives-⊔ℕ-right p)

≤ℕˢ-gives-⊔ℕ-left : {m n : ℕ} → n ≤ℕˢ m → m ⊔ℕ n ＝ m
≤ℕˢ-gives-⊔ℕ-left {zero} z≤n = refl
≤ℕˢ-gives-⊔ℕ-left {suc m} z≤n = refl
≤ℕˢ-gives-⊔ℕ-left (s≤s p) = ap suc (≤ℕˢ-gives-⊔ℕ-left p)

≤ℕˢ-to-suc : (n : ℕ) → n ≤ℕˢ suc n
≤ℕˢ-to-suc n = ≤ℕˢ-suc (≤ℕˢ-refl n)

------------------------------------------------------------------------
-- Small facts of the structural order

nothing-below-zero : (n : ℕ) → ¬ (n <ℕˢ zero)
nothing-below-zero n ()

below-one-is-zero : (n : ℕ) → n <ℕˢ suc zero → n ＝ zero
below-one-is-zero zero p = refl
below-one-is-zero (suc n) (s≤s ())

------------------------------------------------------------------------
-- The stepwise order

infix 30 _≤ℕ′_

data _≤ℕ′_ (m : ℕ) : ℕ → Set where
  ≤ℕ′-refl : m ≤ℕ′ m
  ≤ℕ′-step : {n : ℕ} → m ≤ℕ′ n → m ≤ℕ′ suc n

zero-≤ℕ′ : (n : ℕ) → zero ≤ℕ′ n
zero-≤ℕ′ zero = ≤ℕ′-refl
zero-≤ℕ′ (suc n) = ≤ℕ′-step (zero-≤ℕ′ n)

suc-≤ℕ′ : {m n : ℕ} → m ≤ℕ′ n → suc m ≤ℕ′ suc n
suc-≤ℕ′ ≤ℕ′-refl = ≤ℕ′-refl
suc-≤ℕ′ (≤ℕ′-step p) = ≤ℕ′-step (suc-≤ℕ′ p)

≤ℕˢ-to-≤ℕ′ : {m n : ℕ} → m ≤ℕˢ n → m ≤ℕ′ n
≤ℕˢ-to-≤ℕ′ {zero} {n} z≤n = zero-≤ℕ′ n
≤ℕˢ-to-≤ℕ′ (s≤s p) = suc-≤ℕ′ (≤ℕˢ-to-≤ℕ′ p)

------------------------------------------------------------------------
-- Sequences rising at every step

increasing-along-≤ℕ′ : (g : ℕ → ℕ) → ((n : ℕ) → g n <ℕˢ g (suc n)) →
  {m n : ℕ} → suc m ≤ℕ′ n → g m <ℕˢ g n
increasing-along-≤ℕ′ g up {m} ≤ℕ′-refl = up m
increasing-along-≤ℕ′ g up (≤ℕ′-step {n} p) =
  <ℕˢ-trans (increasing-along-≤ℕ′ g up p) (up n)

increasing-from-steps : (g : ℕ → ℕ) → ((n : ℕ) → g n <ℕˢ g (suc n)) →
  {m n : ℕ} → m <ℕˢ n → g m <ℕˢ g n
increasing-from-steps g up p = increasing-along-≤ℕ′ g up (≤ℕˢ-to-≤ℕ′ p)

------------------------------------------------------------------------
-- Pairing

next-pair : ℕ × ℕ → ℕ × ℕ
next-pair (m , zero) = zero , suc m
next-pair (m , suc n) = suc m , n

diagonal-start : ℕ → ℕ
diagonal-start zero = zero
diagonal-start (suc d) = suc (diagonal-start d + d)

ℕ-unpair : ℕ → ℕ × ℕ
ℕ-unpair zero = zero , zero
ℕ-unpair (suc k) = next-pair (ℕ-unpair k)

ℕ-pair : ℕ → ℕ → ℕ
ℕ-pair m n = diagonal-start (m + n) + m

------------------------------------------------------------------------
-- Properties

private
  pair-suc : (m n : ℕ) → ℕ-pair (suc m) n ＝ suc (ℕ-pair m (suc n))
  pair-suc m n =
    +-suc-right (diagonal-start (suc (m + n))) m
      ∙ ap (λ t → suc (diagonal-start t + m)) (+-suc-right m n ⁻¹)

  pair-zero-suc : (n : ℕ) → ℕ-pair zero (suc n) ＝ suc (ℕ-pair n zero)
  pair-zero-suc n =
    +-zero-right (diagonal-start (suc n))
      ∙ ap (λ t → suc (diagonal-start t + n)) (+-zero-right n ⁻¹)

  unpair-pair-on : (d m n : ℕ) → m + n ＝ d →
    ℕ-unpair (ℕ-pair m n) ＝ (m , n)
  unpair-pair-on d (suc m) n e =
    ap ℕ-unpair (pair-suc m n)
      ∙ ap next-pair (unpair-pair-on d m (suc n) (+-suc-right m n ∙ e))
  unpair-pair-on zero zero zero e = refl
  unpair-pair-on (suc d) zero (suc n) e =
    ap ℕ-unpair (pair-zero-suc n)
      ∙ ap next-pair
        (unpair-pair-on d n zero (+-zero-right n ∙ suc-is-injective e))

ℕ-unpair-pair : (m n : ℕ) → ℕ-unpair (ℕ-pair m n) ＝ (m , n)
ℕ-unpair-pair m n = unpair-pair-on (m + n) m n refl
