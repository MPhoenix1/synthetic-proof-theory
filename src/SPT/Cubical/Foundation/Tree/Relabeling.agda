{-# OPTIONS --safe --cubical-compatible #-}
{-# OPTIONS -WnoUnsupportedIndexedMatch #-}

module SPT.Cubical.Foundation.Tree.Relabeling where

-- Relabeling and relative substitution through a common ambient signature,
-- from the minimal data of a signature relabeling. `relabel-tree R`
-- replaces every source operation by its image; each target position is
-- projected to its exact source position, and boundary coherence performs
-- only the judgment transport of that child; holes stay
-- (`relabel-tree`, `relabel-tree-hole`):
--
--   relabel-tree R (node o k)
--     = node (operation-map o)
--         (λ p. transport (relabel-tree R (k (project p)))).
--
-- Trees of one signature substitute into a tree of another when both are
-- relabeled into a common ambient signature (`relative-bind`,
-- `relative-bind-hole`):
--
--   relative-bind R S f t = bind (relabel-tree S ∘ f) (relabel-tree R t).
--
-- No operation, child or hole is generated by an executor or reconstructed
-- from an extensional shadow.

open import SPT.Cubical.Base
open import SPT.Cubical.Foundation.Signature.Sum
  using (Signature-Over; to-signature)
open import SPT.Cubical.Foundation.Signature.Relabeling using
  ( Signature-Relabeling; operation-map; target-position-projection
  ; boundary-coherence )
open import SPT.Cubical.Foundation.Tree using (Tree; hole; node)
open import SPT.Cubical.Foundation.Tree.Substitution using (bind)

------------------------------------------------------------------------
-- Relabeling along minimal signature data

module _ {ℓj ℓo₁ ℓp₁ ℓo₂ ℓp₂ ℓx : Level} {J : Set ℓj}
  {source : Signature-Over J ℓo₁ ℓp₁} {target : Signature-Over J ℓo₂ ℓp₂}
  (relabeling : Signature-Relabeling source target) {X : J → Set ℓx}
  where

  -- Every source operation is replaced by its image, and every target
  -- child is the relabeled source child at the projected position.
  relabel-tree : {j : J} →
    Tree (to-signature source) X j → Tree (to-signature target) X j
  relabel-tree (hole x) = hole x
  relabel-tree (node o child) =
    node (operation-map relabeling o)
      (λ p →
        transport (λ k → Tree (to-signature target) X k)
          (boundary-coherence relabeling o p)
          (relabel-tree (child (target-position-projection relabeling o p))))

  relabel-tree-hole : {j : J} (x : X j) → relabel-tree (hole x) ＝ hole x
  relabel-tree-hole x = refl

------------------------------------------------------------------------
-- Relative substitution through one common ambient signature

-- The outer tree and every replacement may come from different
-- signatures. Both relabelings into the common ambient signature are
-- inputs; same-signature `bind` then substitutes.

module _ {ℓj ℓo₁ ℓp₁ ℓo₂ ℓp₂ ℓo₃ ℓp₃ ℓx ℓy : Level} {J : Set ℓj}
  {outer-signature : Signature-Over J ℓo₁ ℓp₁}
  {inner-signature : Signature-Over J ℓo₂ ℓp₂}
  {ambient-signature : Signature-Over J ℓo₃ ℓp₃}
  (outer-relabeling :
    Signature-Relabeling outer-signature ambient-signature)
  (inner-relabeling :
    Signature-Relabeling inner-signature ambient-signature)
  {X : J → Set ℓx} {Y : J → Set ℓy}
  (replacement : (j : J) → X j → Tree (to-signature inner-signature) Y j)
  where

  -- Mathematical shape:
  -- relative-bind t = bind (relabel-tree S ∘ f) (relabel-tree R t).
  relative-bind : {j : J} → Tree (to-signature outer-signature) X j →
    Tree (to-signature ambient-signature) Y j
  relative-bind tree =
    bind (λ j x → relabel-tree inner-relabeling (replacement j x))
      (relabel-tree outer-relabeling tree)

  relative-bind-hole : {j : J} (x : X j) →
    relative-bind (hole x) ＝ relabel-tree inner-relabeling (replacement j x)
  relative-bind-hole x = refl
