{-# OPTIONS --safe --cubical-compatible #-}
{-# OPTIONS -WnoUnsupportedIndexedMatch #-}

module SPT.Cubical.Foundation.Accessibility where

-- For a type-valued relation `_<_` on `A`, a point `x` is accessible when every
-- point below it is accessible. Accessibility is generated by this one rule, so
-- it can be eliminated by induction: a property that holds at `x` whenever it
-- holds at every point below `x` holds at every accessible point. The relation
-- is well-founded when every point is accessible. Every point below an
-- accessible point is accessible, and no accessible point lies below itself.
--
-- A well-founded relation bundles a carrier, a relation on it and the proof
-- that the relation is well-founded. Its carrier and its relation `x <⟨ O ⟩ y`
-- are read through top-level functions, which are the only spellings used
-- outside this module. A map of carriers that preserves the relation is an
-- order-preserving map; these have identities and composites.

open import SPT.Cubical.Base

------------------------------------------------------------------------
-- Accessibility

module _ {ℓ κ : Level} {A : Set ℓ} where

  data is-accessible (_<_ : A → A → Set κ) (x : A) : Set (ℓ ⊔ κ) where
    acc : ((y : A) → y < x → is-accessible _<_ y) → is-accessible _<_ x

  is-well-founded : (A → A → Set κ) → Set (ℓ ⊔ κ)
  is-well-founded _<_ = (x : A) → is-accessible _<_ x

------------------------------------------------------------------------
-- Well-founded relations

record Well-Founded-Relation (ℓ κ : Level) : Set (lsuc (ℓ ⊔ κ)) where
  constructor well-founded-relation
  field
    carrier : Set ℓ
    relation : carrier → carrier → Set κ
    relation-is-well-founded : is-well-founded relation

module _ {ℓ κ : Level} (O : Well-Founded-Relation ℓ κ) where

  Carrier : Set ℓ
  Carrier = Well-Founded-Relation.carrier O

below : {ℓ κ : Level} (O : Well-Founded-Relation ℓ κ) →
  Carrier O → Carrier O → Set κ
below O = Well-Founded-Relation.relation O

infix 30 below
syntax below O x y = x <⟨ O ⟩ y

module _ {ℓ κ : Level} (O : Well-Founded-Relation ℓ κ) where

  below-is-well-founded : is-well-founded (below O)
  below-is-well-founded = Well-Founded-Relation.relation-is-well-founded O

------------------------------------------------------------------------
-- Order-preserving maps

module _ {ℓ κ ℓ′ κ′ : Level} where

  record Order-Preserving-Map (O : Well-Founded-Relation ℓ κ)
    (O′ : Well-Founded-Relation ℓ′ κ′) : Set (ℓ ⊔ κ ⊔ ℓ′ ⊔ κ′) where
    constructor order-preserving-map
    field
      map : Carrier O → Carrier O′
      preserves : {x y : Carrier O} → x <⟨ O ⟩ y → map x <⟨ O′ ⟩ map y

  open Order-Preserving-Map public

------------------------------------------------------------------------
-- Induction

module _ {ℓ κ μ : Level} {A : Set ℓ} {_<_ : A → A → Set κ} where

  accessible-induction : (P : A → Set μ) →
    ((x : A) → ((y : A) → y < x → P y) → P x) →
    (x : A) → is-accessible _<_ x → P x
  accessible-induction P step x (acc smaller) =
    step x (λ y y<x → accessible-induction P step y (smaller y y<x))

------------------------------------------------------------------------
-- Predecessors and loops

module _ {ℓ κ : Level} {A : Set ℓ} {_<_ : A → A → Set κ} {x : A} where

  predecessors-are-accessible : is-accessible _<_ x →
    (y : A) → y < x → is-accessible _<_ y
  predecessors-are-accessible (acc smaller) = smaller

  accessible-points-have-no-loops : is-accessible _<_ x → ¬ (x < x)
  accessible-points-have-no-loops (acc smaller) loop =
    accessible-points-have-no-loops (smaller x loop) loop

------------------------------------------------------------------------
-- Identities and composites of order-preserving maps

module _ {ℓ κ : Level} (O : Well-Founded-Relation ℓ κ) where

  order-preserving-identity : Order-Preserving-Map O O
  order-preserving-identity = order-preserving-map id (λ x<y → x<y)

module _ {ℓ κ ℓ′ κ′ ℓ″ κ″ : Level} {O : Well-Founded-Relation ℓ κ}
  {O′ : Well-Founded-Relation ℓ′ κ′} {O″ : Well-Founded-Relation ℓ″ κ″}
  where

  order-preserving-composite : Order-Preserving-Map O′ O″ →
    Order-Preserving-Map O O′ → Order-Preserving-Map O O″
  order-preserving-composite g f =
    order-preserving-map (map g ∘ map f)
      (λ x<y → preserves g (preserves f x<y))
