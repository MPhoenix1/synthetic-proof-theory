{-# OPTIONS --safe --without-K #-}

module SPT.Base.Identity where

-- For points `x` and `y` of a type `A`, the identity type `x ＝ y` is the type
-- of identifications of `x` with `y`, generated by `refl : x ＝ x`. It is the
-- identity type of `Agda.Builtin.Equality`, under SPT's name and fixity, given
-- in the renaming; so it is also the standard library's `_≡_`, and the two
-- share every identification. SPT uses no `rewrite`. Nothing here assumes K:
-- an identification is matched against `refl` only where its endpoints are
-- free to be unified.
--
-- Identifications are applied by functions (`ap`, `ap₂`), transported along
-- type families (`transport`), composed (`p ∙ q`) and inverted (`p ⁻¹`).
-- Composition is associative and has `refl` as unit and `p ⁻¹` as inverse, up
-- to identification. The notation `x ＝⟨ p ⟩ y ＝⟨ q ⟩ z ∎` writes a chain of
-- identifications.

open import Agda.Builtin.Equality public
  using (refl)
  renaming (_≡_ to infix 6 _＝_)

open import SPT.Base.Universes
open import SPT.Base.Functions using (id; _∘_)
open import SPT.Base.Empty using (¬_)

------------------------------------------------------------------------
-- Distinct points, composition, inverses and chains

module _ {ℓ : Level} {A : Set ℓ} where

  infix 6 _≠_
  infixl 15 _∙_
  infix 25 _⁻¹
  infixr 0 _＝⟨_⟩_
  infix 1 _∎

  _≠_ : A → A → Set ℓ
  x ≠ y = ¬ (x ＝ y)

  _∙_ : {x y z : A} → x ＝ y → y ＝ z → x ＝ z
  refl ∙ q = q

  _⁻¹ : {x y : A} → x ＝ y → y ＝ x
  refl ⁻¹ = refl

  _＝⟨_⟩_ : (x : A) {y z : A} → x ＝ y → y ＝ z → x ＝ z
  x ＝⟨ p ⟩ q = p ∙ q

  _∎ : (x : A) → x ＝ x
  x ∎ = refl

------------------------------------------------------------------------
-- Action of functions

module _ {ℓ κ : Level} {A : Set ℓ} {B : Set κ} where

  ap : (f : A → B) {x y : A} → x ＝ y → f x ＝ f y
  ap f refl = refl

module _ {ℓ κ μ : Level} {A : Set ℓ} {B : Set κ} {C : Set μ} where

  ap₂ : (f : A → B → C) {x x′ : A} {y y′ : B} →
    x ＝ x′ → y ＝ y′ → f x y ＝ f x′ y′
  ap₂ f refl refl = refl

------------------------------------------------------------------------
-- Transport

module _ {ℓ κ : Level} {A : Set ℓ} (P : A → Set κ) where

  transport : {x y : A} → x ＝ y → P x → P y
  transport refl u = u

------------------------------------------------------------------------
-- Composition is a groupoid, up to identification

module _ {ℓ : Level} {A : Set ℓ} where

  refl-left-neutral : {x y : A} (p : x ＝ y) → refl ∙ p ＝ p
  refl-left-neutral p = refl

  refl-right-neutral : {x y : A} (p : x ＝ y) → p ∙ refl ＝ p
  refl-right-neutral refl = refl

  ∙assoc : {x y z w : A} (p : x ＝ y) (q : y ＝ z) (r : z ＝ w) →
    (p ∙ q) ∙ r ＝ p ∙ (q ∙ r)
  ∙assoc refl q r = refl

  left-inverse : {x y : A} (p : x ＝ y) → p ⁻¹ ∙ p ＝ refl
  left-inverse refl = refl

  right-inverse : {x y : A} (p : x ＝ y) → p ∙ p ⁻¹ ＝ refl
  right-inverse refl = refl

  ap-id : {x y : A} (p : x ＝ y) → ap id p ＝ p
  ap-id refl = refl

------------------------------------------------------------------------
-- Functions act functorially

module _ {ℓ κ : Level} {A : Set ℓ} {B : Set κ} where

  ap-∙ : (f : A → B) {x y z : A} (p : x ＝ y) (q : y ＝ z) →
    ap f (p ∙ q) ＝ ap f p ∙ ap f q
  ap-∙ f refl q = refl

  ap-⁻¹ : (f : A → B) {x y : A} (p : x ＝ y) → ap f (p ⁻¹) ＝ ap f p ⁻¹
  ap-⁻¹ f refl = refl

module _ {ℓ κ μ : Level} {A : Set ℓ} {B : Set κ} {C : Set μ} where

  ap-∘ : (f : A → B) (g : B → C) {x y : A} (p : x ＝ y) →
    ap (g ∘ f) p ＝ ap g (ap f p)
  ap-∘ f g refl = refl

------------------------------------------------------------------------
-- Transport along a composite

module _ {ℓ κ : Level} {A : Set ℓ} (P : A → Set κ) where

  transport-∙ : {x y z : A} (p : x ＝ y) (q : y ＝ z) (u : P x) →
    transport P (p ∙ q) u ＝ transport P q (transport P p u)
  transport-∙ refl q u = refl
